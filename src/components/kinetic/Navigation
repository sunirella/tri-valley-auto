import React, { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import { AnimatePresence, motion } from "framer-motion";
import { Phone } from "lucide-react";

const NAV = [
  { label: "Services", to: "/#services" },
  { label: "Offers",   to: "/#offers"   },
  { label: "Reviews",  to: "/#ledger"   },
  { label: "Contact",  to: "/#contact"  },
];

export default function Navigation() {
  const [scrolled, setScrolled]   = useState(false);
  const [menuOpen, setMenuOpen]   = useState(false);

  useEffect(() => {
    const fn = () => setScrolled(window.scrollY > 30);
    window.addEventListener("scroll", fn, { passive: true });
    fn();
    return () => window.removeEventListener("scroll", fn);
  }, []);

  return (
    <header className={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${
      scrolled ? "bg-background/95 backdrop-blur-md border-b border-hairline" : "bg-transparent"
    }`}>
      <div className="max-w-[1440px] mx-auto px-5 md:px-10 lg:px-16">
        <div className="flex items-center justify-between h-16 md:h-18">

          {/* Logo */}
          <Link to="/" className="flex items-center gap-3">
            <div className="bg-accent w-8 h-8 flex items-center justify-center flex-shrink-0">
              <span className="font-display font-black text-accent-foreground text-sm leading-none">TV</span>
            </div>
            <div className="leading-none">
              <div className="font-display font-800 text-base tracking-wide uppercase text-foreground">Tri Valley Auto</div>
              <div className="text-micro text-muted-foreground">Pleasanton, CA</div>
            </div>
          </Link>

          {/* Desktop nav */}
          <nav className="hidden md:flex items-center gap-8">
            {NAV.map((item) => (
              <a key={item.to} href={item.to}
                className="text-label text-foreground/60 hover:text-accent transition-colors">
                {item.label}
              </a>
            ))}
          </nav>

          {/* Right */}
          <div className="flex items-center gap-3">
            <a href="tel:+19256008975"
              className="hidden lg:flex items-center gap-2 text-label text-foreground/60 hover:text-accent transition-colors">
              <Phone className="w-3.5 h-3.5" />
              (925) 600-8975
            </a>
            <Link to="/book"
              className="bg-accent text-accent-foreground px-5 py-2.5 text-label font-bold hover:bg-highlight transition-colors duration-200">
              BOOK NOW
            </Link>
            <button className="md:hidden p-2" onClick={() => setMenuOpen(!menuOpen)}>
              <div className={`w-5 h-0.5 bg-foreground transition-all mb-1.5 ${menuOpen ? "rotate-45 translate-y-2" : ""}`} />
              <div className={`w-5 h-0.5 bg-foreground transition-all mb-1.5 ${menuOpen ? "opacity-0" : ""}`} />
              <div className={`w-5 h-0.5 bg-foreground transition-all ${menuOpen ? "-rotate-45 -translate-y-2" : ""}`} />
            </button>
          </div>
        </div>
      </div>

      {/* Mobile menu */}
      <AnimatePresence>
        {menuOpen && (
          <motion.div initial={{ height: 0 }} animate={{ height: "auto" }} exit={{ height: 0 }}
            className="md:hidden overflow-hidden bg-card border-t border-hairline">
            <div className="px-5 py-5 space-y-1">
              {NAV.map((item) => (
                <a key={item.to} href={item.to} onClick={() => setMenuOpen(false)}
                  className="block font-display font-bold text-2xl uppercase text-foreground/80 hover:text-accent py-2 border-b border-hairline last:border-0 transition-colors">
                  {item.label}
                </a>
              ))}
              <a href="tel:+19256008975" className="block font-display font-bold text-2xl uppercase text-accent py-2">
                (925) 600-8975
              </a>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </header>
  );
}
