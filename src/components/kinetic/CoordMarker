    tl: "top-4 left-4",
    tr: "top-4 right-4",
    bl: "bottom-4 left-4",
    br: "bottom-4 right-4",
  };

  const lines = {
    tl: "before:top-0 before:left-0 before:w-3 before:h-px after:top-0 after:left-0 after:w-px after:h-3",
